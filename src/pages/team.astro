---
import Base from '../layouts/Base.astro';
import { getMembers, GROUPS } from '../lib/data';
const members = await getMembers();
---
<Base title="Team">
  <h1>Team</h1>
  {GROUPS.map((g) => {
    const list = members.filter((m) => m.group === g.key);
    return list.length > 0 && (
      <section>
        <h2 id={g.key}>{g.label}</h2>
        <div class="team-grid">
          {list.map((m) => (
            <div class="member">
              {m.photo
                ? <img class="photo" src={m.photo} alt={m.name} loading="lazy" />
                : <div class="photo placeholder" aria-hidden="true">👤</div>}
              <div class="name">{m.name}</div>
              <div class="role">{m.role.split('/').map((r, i) => <>{i > 0 && <br />}{r.trim()}</>)}</div>
              {m.email && <a class="email" href={`mailto:${m.email}`}>{m.email}</a>}
            </div>
          ))}
        </div>
      </section>
    );
  })}
</Base>
